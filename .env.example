# =============================================================================
# Voice Receptionist — Environment Variables
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env with real secrets.
# =============================================================================

# OmniDimension API credentials (https://omnidim.io/dashboard)
OMNIDIM_API_KEY=sk-omni-your-api-key-here
OMNIDIM_AGENT_ID=agent_your_agent_id_here
OMNIDIM_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
OMNIDIM_BASE_URL=https://backend.omnidim.io/api/v1

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string-in-production
LOG_LEVEL=INFO

# Database (SQLite for dev, Postgres for prod)
DATABASE_URL=sqlite+aiosqlite:///./voice_receptionist.db

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Business config file path (relative to backend/ directory)
BUSINESS_CONFIG_PATH=business_config.yaml

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
